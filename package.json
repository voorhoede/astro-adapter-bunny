{
  "name": "astro-adapter-bunny",
  "version": "0.0.0",
  "private": true,
  "description": "Astro adapter for bunny.net Edge Scripting.",
  "license": "ISC",
  "author": "De Voorhoede",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voorhoede/astro-adapter-bunny.git"
  },
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/types/lib/config/config.d.ts",
      "default": "./dist/config.js"
    },
    "./script.js": "./dist/script.js",
    "./preview.js": "./dist/preview.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@astrojs/internal-helpers": "^0.13.2",
    "@bunny.net/edgescript-sdk": "^0.13.0",
    "rolldown": "^1.2.15"
  },
  "devDependencies": {
    "@std/http": "npm:@jsr/std__http@^1.1.4",
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "astro": "^7.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "actions"
  ]
}
